{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules"],
  "include": [
    "global.d.ts",
    ".plasmo/index.d.ts",
    ".plasmo/global.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "paths": {
      "~*": ["./*"],
      "*": ["./*"]
    },
    "moduleResolution": "bundler"
  }
}
