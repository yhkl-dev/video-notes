{
  "name": "video-notes",
  "displayName": "Video notes",
  "version": "0.0.5",
  "description": "Capture, annotate, and replay video segments. Markdown notes with screenshots, tags, search, export, dark mode, and keyboard shortcuts.",
  "author": "kaiyang939325@gmail.com",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check '**/*.{ts,tsx,json,css}' --ignore-path .gitignore"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "dompurify": "^3.4.11",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "plasmo": "0.90.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.0.302",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "prettier": "3.9.5",
    "tailwindcss": "^3.4.19",
    "typescript": "7.0.2"
  },
  "manifest": {
    "default_locale": "en",
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "scripting",
      "activeTab",
      "tabs",
      "unlimitedStorage",
      "identity"
    ],
    "oauth2": {
      "client_id": "832788737999-dht9nulao2epiedrp2hjt2mlv4aco8rp.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/drive.file"
      ]
    }
  }
}
